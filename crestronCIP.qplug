--==============================================================================
-- Crestron CIP Protocol Gateway for Q-SYS
-- Communicates with Crestron control system via CIP (TCP port 41794)
-- Configurable IP, IPID, and signal counts via properties
--==============================================================================

PluginInfo = {
  Name = "wxl_personal_plug~crestronCIP",
  Version = "1.1.8",
  Author = "longwang",
  Id = "b7e8a2c1-3d4f-4a6e-9c2d-8f1e5b7a3c9d",
  Description = "Crestron CIP protocol gateway with configurable signal counts"
}

-- Color palette
Palette = {
  Blue    = {46, 63, 87},
  White   = {255, 255, 255},
  Black   = {0, 0, 0},
  Red     = {220, 60, 60},
  Green   = {60, 180, 60},
  Orange  = {230, 140, 30},
  Gray    = {160, 160, 160},
}

-- Build dynamic page list based on configured signal counts
-- Each signal page holds max 50 pairs (In + Out)
local SIGNALS_PER_PAGE = 50

function BuildPageList(props)
  local pages = {{ name = "Connection", ptype = "connection" }}
  table.insert(pages, { name = "Monitor", ptype = "monitor" })
  local digCount = math.floor(props["digital_count"].Value)
  local anaCount = math.floor(props["analog_count"].Value)
  local serCount = math.floor(props["serial_count"].Value)

  local function addSignalPages(label, count, ptype)
    local numPages = math.ceil(count / SIGNALS_PER_PAGE)
    for p = 1, numPages do
      local startIdx = (p - 1) * SIGNALS_PER_PAGE + 1
      local endIdx = math.min(p * SIGNALS_PER_PAGE, count)
      table.insert(pages, {
        name = string.format("%s %d-%d", label, startIdx, endIdx),
        ptype = ptype,
        startIdx = startIdx,
        endIdx = endIdx
      })
    end
  end

  addSignalPages("Digital", digCount, "digital")
  addSignalPages("Analog", anaCount, "analog")
  addSignalPages("Serial", serCount, "serial")
  return pages
end

function GetPages(props)
  local pages = BuildPageList(props)
  local result = {}
  for _, p in ipairs(pages) do
    table.insert(result, { name = p.name })
  end
  return result
end

function GetProperties()
  local props = {}

  -- Crestron device IP address
  table.insert(props, {
    Name = "cip_ip",
    Type = "string",
    Value = "192.168.27.224"
  })

  -- Device IPID (hex string, 03-FF)
  table.insert(props, {
    Name = "cip_ipid",
    Type = "string",
    Value = "03"
  })

  -- Digital signal count
  table.insert(props, {
    Name = "digital_count",
    Type = "integer",
    Min = 0,
    Max = 500,
    Value = 100
  })

  -- Analog signal count
  table.insert(props, {
    Name = "analog_count",
    Type = "integer",
    Min = 0,
    Max = 500,
    Value = 100
  })

  -- Serial signal count
  table.insert(props, {
    Name = "serial_count",
    Type = "integer",
    Min = 0,
    Max = 500,
    Value = 100
  })

  -- Digital output pulse width (seconds) for trigger reliability
  table.insert(props, {
    Name = "digital_pulse_width",
    Type = "double",
    Min = 0.1,
    Max = 2.0,
    Value = 0.3
  })

  -- Auto reconnect on disconnect
  table.insert(props, {
    Name = "auto_reconnect",
    Type = "boolean",
    Value = true
  })

  -- Reconnect interval (seconds)
  table.insert(props, {
    Name = "reconnect_interval",
    Type = "double",
    Min = 1,
    Max = 60,
    Value = 5
  })

  -- Periodic sync interval (seconds, 0 = disabled)
  -- Re-sends update request so Crestron re-dumps ALL join values
  -- (Crestron only sends on change; periodic sync keeps static signals fresh)
  table.insert(props, {
    Name = "sync_interval",
    Type = "integer",
    Min = 0,
    Max = 3600,
    Value = 60,
    Header = "Sync",
    Comment = "Seconds between full re-syncs. 0 = off. Default 60."
  })

  return props
end

function RectifyProperties(props)
  -- Clamp counts to valid range
  for _, name in ipairs({"digital_count", "analog_count", "serial_count"}) do
    if props[name] then
      local v = math.floor(tonumber(props[name].Value) or 32)
      props[name].Value = math.min(math.max(v, 0), 500)
    end
  end
  -- Clamp pulse width
  if props["digital_pulse_width"] then
    local v = tonumber(props["digital_pulse_width"].Value) or 0.3
    props["digital_pulse_width"].Value = math.min(math.max(v, 0.1), 2.0)
  end
  -- Clamp reconnect interval
  if props["reconnect_interval"] then
    local v = tonumber(props["reconnect_interval"].Value) or 5
    props["reconnect_interval"].Value = math.min(math.max(v, 1), 60)
  end
  -- Validate IPID hex (03-FF)
  if props["cip_ipid"] then
    local val = tonumber(props["cip_ipid"].Value, 16)
    if not val or val < 0x03 or val > 0xFF then
      props["cip_ipid"].Value = "03"
    end
  end
  return props
end

function GetComponents(props)
  return {}
end

function GetPins(props)
  return {}
end

function GetColor(props)
  return Palette.Blue
end

function GetPrettyName(props)
  return "crestronCIP v" .. PluginInfo.Version
end

-- Define controls
function GetControls(props)
  local ctrls = {}
  local digCount = math.floor(props["digital_count"].Value)
  local anaCount = math.floor(props["analog_count"].Value)
  local serCount = math.floor(props["serial_count"].Value)

  -- IP address input (panel override only, NO external pin)
  table.insert(ctrls, {
    Name = "IP_Input",
    ControlType = "Text",
    DefaultValue = props["cip_ip"].Value,
    UserPin = false,
    Count = 1
  })

  -- IPID input (panel override only, hex string e.g. "03", NO external pin)
  table.insert(ctrls, {
    Name = "IPID_Input",
    ControlType = "Text",
    DefaultValue = props["cip_ipid"].Value,
    UserPin = false,
    Count = 1
  })

  -- Connect / disconnect toggle
  table.insert(ctrls, {
    Name = "CIP_Connect",
    ControlType = "Button",
    ButtonType = "Toggle",
    DefaultValue = false,
    PinStyle = "Input",
    UserPin = true,
    Count = 1
  })

  -- Connection status indicator
  table.insert(ctrls, {
    Name = "CIP_Status",
    ControlType = "Button",
    ButtonType = "Toggle",
    DefaultValue = false,
    PinStyle = "Output",
    UserPin = true,
    Count = 1
  })

  -- Monitor: system event log output (external pin available)
  table.insert(ctrls, {
    Name = "monitor_log",
    ControlType = "Text",
    DefaultValue = "",
    PinStyle = "Output",
    UserPin = true,
    Count = 1
  })

  -- Monitor: RX log (Crestron -> Q-SYS) output (external pin available)
  table.insert(ctrls, {
    Name = "monitor_rx",
    ControlType = "Text",
    DefaultValue = "",
    PinStyle = "Output",
    UserPin = true,
    Count = 1
  })

  -- Monitor: TX log (Q-SYS -> Crestron) output (external pin available)
  table.insert(ctrls, {
    Name = "monitor_tx",
    ControlType = "Text",
    DefaultValue = "",
    PinStyle = "Output",
    UserPin = true,
    Count = 1
  })

  -- Monitor: clear button
  table.insert(ctrls, {
    Name = "monitor_clear",
    ControlType = "Button",
    ButtonType = "Trigger",
    DefaultValue = false,
    UserPin = false,
    Count = 1
  })

  -- Digital inputs (from Crestron to Q-SYS) - individual controls for pin visibility
  for i = 1, digCount do
    table.insert(ctrls, {
      Name = "Digital_In_" .. i,
      ControlType = "Button",
      ButtonType = "Toggle",
      DefaultValue = false,
      PinStyle = "Output",
      UserPin = true,
      Count = 1
    })
  end

  -- Digital outputs (from Q-SYS to Crestron)
  for i = 1, digCount do
    table.insert(ctrls, {
      Name = "Digital_Out_" .. i,
      ControlType = "Button",
      ButtonType = "Toggle",
      DefaultValue = false,
      PinStyle = "Input",
      UserPin = true,
      Count = 1
    })
  end

  -- Analog inputs (from Crestron to Q-SYS)
  for i = 1, anaCount do
    table.insert(ctrls, {
      Name = "Analog_In_" .. i,
      ControlType = "Knob",
      ControlUnit = "Integer",
      Min = 0,
      Max = 65535,
      DefaultValue = 0,
      PinStyle = "Output",
      UserPin = true,
      Count = 1
    })
  end

  -- Analog input value display (no pin)
  for i = 1, anaCount do
    table.insert(ctrls, {
      Name = "Analog_In_" .. i .. "_Val",
      ControlType = "Text",
      DefaultValue = "0",
      UserPin = false,
      Count = 1
    })
  end

  -- Analog outputs (from Q-SYS to Crestron)
  for i = 1, anaCount do
    table.insert(ctrls, {
      Name = "Analog_Out_" .. i,
      ControlType = "Knob",
      ControlUnit = "Integer",
      Min = 0,
      Max = 65535,
      DefaultValue = 0,
      PinStyle = "Input",
      UserPin = true,
      Count = 1
    })
  end

  -- Analog output value display (no pin)
  for i = 1, anaCount do
    table.insert(ctrls, {
      Name = "Analog_Out_" .. i .. "_Val",
      ControlType = "Text",
      DefaultValue = "0",
      UserPin = false,
      Count = 1
    })
  end

  -- Serial inputs (from Crestron to Q-SYS)
  for i = 1, serCount do
    table.insert(ctrls, {
      Name = "Serial_In_" .. i,
      ControlType = "Text",
      DefaultValue = "",
      PinStyle = "Output",
      UserPin = true,
      Count = 1
    })
  end

  -- Serial outputs (from Q-SYS to Crestron)
  for i = 1, serCount do
    table.insert(ctrls, {
      Name = "Serial_Out_" .. i,
      ControlType = "Text",
      DefaultValue = "",
      PinStyle = "Input",
      UserPin = true,
      Count = 1
    })
  end

  return ctrls
end

-- Define panel layout
function GetControlLayout(props)
  local layout = {}
  local graphics = {}
  local pages = BuildPageList(props)
  local CurrentPage = pages[props["page_index"].Value]

  -- Helper: render a signal page (Digital / Analog / Serial)
  local function renderSignalPage(pageInfo, signalType)
    local fs = 10
    local rowH = 24
    local y = 28

    -- Title
    table.insert(graphics, {
      Type = "Text",
      Text = pageInfo.name,
      FontSize = 14,
      HTextAlign = "Left",
      Position = {8, 4},
      Size = {300, 20}
    })

    -- Column headers
    table.insert(graphics, {
      Type = "Text",
      Text = "In (from Crestron)",
      FontSize = fs,
      HTextAlign = "Center",
      Position = {34, y},
      Size = {124, 16}
    })
    table.insert(graphics, {
      Type = "Text",
      Text = "Out (to Crestron)",
      FontSize = fs,
      HTextAlign = "Center",
      Position = {196, y},
      Size = {124, 16}
    })
    y = y + 20

    for i = pageInfo.startIdx, pageInfo.endIdx do
      local inName = signalType .. "_In_" .. i
      local outName = signalType .. "_Out_" .. i
      local numLabel = tostring(i)

      -- Number label for In
      table.insert(graphics, {
        Type = "Text",
        Text = numLabel,
        FontSize = fs,
        HTextAlign = "Right",
        Position = {8, y + 2},
        Size = {22, rowH - 4}
      })

      -- In control
      if signalType == "Analog" then
        layout[inName] = {
          PrettyName = signalType .. " In " .. i,
          Style = "Fader",
          Margin = 1,
          Position = {34, y},
          Size = {82, rowH - 2}
        }
        layout[inName .. "_Val"] = {
          PrettyName = signalType .. " In " .. i .. " Val",
          Style = "Text",
          FontSize = 9,
          HTextAlign = "Left",
          Position = {120, y + 2},
          Size = {42, rowH - 4}
        }
      else
        local inLayout = {
          PrettyName = signalType .. " In " .. i,
          Style = (signalType == "Digital" and "Button" or "Text"),
          Margin = 1,
          Position = {34, y},
          Size = {124, rowH - 2}
        }
        if signalType == "Digital" then
          inLayout.ButtonStyle = "Toggle"
          inLayout.Color = Palette.Green
          inLayout.UnlinkOffColor = true
          inLayout.OffColor = {80, 80, 80}
        else
          inLayout.FontSize = 9
          inLayout.HTextAlign = "Left"
        end
        layout[inName] = inLayout
      end

      -- Number label for Out
      table.insert(graphics, {
        Type = "Text",
        Text = numLabel,
        FontSize = fs,
        HTextAlign = "Right",
        Position = {170, y + 2},
        Size = {22, rowH - 4}
      })

      -- Out control
      if signalType == "Analog" then
        layout[outName] = {
          PrettyName = signalType .. " Out " .. i,
          Style = "Fader",
          Margin = 1,
          Position = {196, y},
          Size = {82, rowH - 2}
        }
        layout[outName .. "_Val"] = {
          PrettyName = signalType .. " Out " .. i .. " Val",
          Style = "Text",
          FontSize = 9,
          HTextAlign = "Left",
          Position = {282, y + 2},
          Size = {42, rowH - 4}
        }
      else
        local outLayout = {
          PrettyName = signalType .. " Out " .. i,
          Style = (signalType == "Digital" and "Button" or "Text"),
          Margin = 1,
          Position = {196, y},
          Size = {124, rowH - 2}
        }
        if signalType == "Digital" then
          outLayout.ButtonStyle = "Toggle"
          outLayout.Color = Palette.Red
          outLayout.UnlinkOffColor = true
          outLayout.OffColor = {80, 80, 80}
        else
          outLayout.FontSize = 9
          outLayout.HTextAlign = "Left"
        end
        layout[outName] = outLayout
      end

      y = y + rowH
    end

    -- Notes (bilingual) at bottom of each signal page
    local noteY = y + 8
    table.insert(graphics, {
      Type = "GroupBox",
      Text = "Notes / 说明",
      FontSize = fs,
      HTextAlign = "Left",
      Fill = Palette.White,
      StrokeColor = Palette.Black,
      StrokeWidth = 1,
      CornerRadius = 6,
      Position = {8, noteY},
      Size = {324, 95}
    })
    local function sNote(text)
      table.insert(graphics, {
        Type = "Text",
        Text = text,
        FontSize = 8,
        HTextAlign = "Left",
        Position = {14, noteY + 16},
        Size = {312, 12}
      })
      noteY = noteY + 12
    end
    sNote(signalType .. " In N: Crestron->QSC, received from processor.")
    sNote(signalType .. " In N: Crestron->QSC，从中控接收。")
    sNote(signalType .. " Out N: QSC->Crestron, sent to processor.")
    sNote(signalType .. " Out N: QSC->Crestron，发送给中控。")
    sNote("Digital Out pulses are stretched to digital_pulse_width (default 0.3s).")
    sNote("Digital Out 脉冲被拉伸至 digital_pulse_width（默认0.3秒）。")
  end

  if CurrentPage.ptype == "connection" then

    local fs = 12

    -- Title
    table.insert(graphics, {
      Type = "Text",
      Text = "crestronCIP",
      FontSize = 14,
      HTextAlign = "Left",
      Position = {8, 4},
      Size = {200, 20}
    })
    table.insert(graphics, {
      Type = "Text",
      Text = "v" .. PluginInfo.Version,
      FontSize = fs,
      HTextAlign = "Right",
      Position = {268, 6},
      Size = {64, 18}
    })

    -- IP Address
    table.insert(graphics, {
      Type = "Text",
      Text = "IP Address:",
      FontSize = fs,
      HTextAlign = "Left",
      Position = {8, 32},
      Size = {80, 20}
    })
    layout["IP_Input"] = {
      PrettyName = "IP Address",
      Style = "Text",
      FontSize = fs,
      HTextAlign = "Left",
      Position = {92, 30},
      Size = {240, 24}
    }

    -- IPID input
    table.insert(graphics, {
      Type = "Text",
      Text = "IPID (hex):",
      FontSize = fs,
      HTextAlign = "Left",
      Position = {8, 62},
      Size = {80, 20}
    })
    layout["IPID_Input"] = {
      PrettyName = "IPID",
      Style = "Text",
      FontSize = fs,
      HTextAlign = "Left",
      Position = {92, 60},
      Size = {80, 24}
    }

    -- Connect button
    layout["CIP_Connect"] = {
      PrettyName = "Connect",
      Legend = "Connect",
      Style = "Button",
      ButtonStyle = "Toggle",
      Color = Palette.Green,
      Margin = 2,
      Position = {8, 90},
      Size = {100, 30}
    }

    -- Status indicator
    table.insert(graphics, {
      Type = "Text",
      Text = "Status:",
      FontSize = fs,
      HTextAlign = "Left",
      Position = {124, 96},
      Size = {50, 20}
    })
    layout["CIP_Status"] = {
      PrettyName = "Connection Status",
      Legend = "",
      Style = "Led",
      Color = Palette.Green,
      Position = {172, 92},
      Size = {28, 26}
    }

    -- Config info
    table.insert(graphics, {
      Type = "Text",
      Text = "Digital: " .. math.floor(props["digital_count"].Value) ..
             "  Analog: " .. math.floor(props["analog_count"].Value) ..
             "  Serial: " .. math.floor(props["serial_count"].Value),
      FontSize = fs,
      HTextAlign = "Left",
      Position = {8, 130},
      Size = {324, 20}
    })

    -- Properties Notes (bilingual)
    table.insert(graphics, {
      Type = "GroupBox",
      Text = "Notes / 说明",
      FontSize = fs,
      HTextAlign = "Left",
      Fill = Palette.White,
      StrokeColor = Palette.Black,
      StrokeWidth = 1,
      CornerRadius = 6,
      Position = {8, 155},
      Size = {324, 1010}
    })
    local noteY = 171
    local noteLine = 13
    local function addNote(text)
      table.insert(graphics, {
        Type = "Text",
        Text = text,
        FontSize = 8,
        HTextAlign = "Left",
        Position = {14, noteY},
        Size = {312, noteLine}
      })
      noteY = noteY + noteLine
    end

    addNote("Crestron CIP Gateway v1.1.8 / Crestron CIP 协议网关")
    addNote("TCP port 41794, connects Q-SYS Core to Crestron processor via CIP.")
    addNote("TCP 端口 41794，通过 CIP 协议连接 Q-SYS Core 与 Crestron 中控。")
    addNote("")
    addNote("Properties / 属性参数:")
    addNote("  cip_ip: default Crestron IP (panel IP_Input overrides)")
    addNote("  cip_ip: 默认 Crestron IP（面板 IP_Input 可覆盖）")
    addNote("  cip_ipid: hex 03-FF, device IP-ID, default 03")
    addNote("  cip_ipid: 十六进制 03-FF，设备 IP-ID，默认 03")
    addNote("  digital/analog/serial_count: 0-500 signals, 50 per page")
    addNote("  digital/analog/serial_count: 0-500 个信号，每页 50 个")
    addNote("  digital_pulse_width: 0.1-2.0s, stretches short trigger pulses")
    addNote("  digital_pulse_width: 0.1-2.0 秒，拉长短触发脉冲保证可靠")
    addNote("  auto_reconnect: true/false, reconnect on disconnect")
    addNote("  auto_reconnect: true/false，断开后自动重连")
    addNote("  reconnect_interval: 1-60s, auto-reconnect interval")
    addNote("  reconnect_interval: 1-60 秒，自动重连间隔")
    addNote("")
    addNote("Signal Pins / 信号引脚:")
    addNote("  Digital_In_N:  Crestron->QSC toggle (boolean)")
    addNote("  Digital_In_N:  Crestron->QSC 开关量（布尔）")
    addNote("  Digital_Out_N: QSC->Crestron toggle, pulse stretched to pulse_width")
    addNote("  Digital_Out_N: QSC->Crestron 开关量，脉冲拉伸至 pulse_width")
    addNote("  Analog_In_N:   Crestron->QSC integer 0-65535")
    addNote("  Analog_In_N:   Crestron->QSC 模拟量 0-65535")
    addNote("  Analog_Out_N:  QSC->Crestron integer 0-65535")
    addNote("  Analog_Out_N:  QSC->Crestron 模拟量 0-65535")
    addNote("  Serial_In_N:   Crestron->QSC text string")
    addNote("  Serial_In_N:   Crestron->QSC 字符串")
    addNote("  Serial_Out_N:  QSC->Crestron text string")
    addNote("  Serial_Out_N:  QSC->Crestron 字符串")
    addNote("  *_Val: value display only, NO external pin")
    addNote("  *_Val: 仅数值显示，无外部引脚")
