    addNote("        重发数字/模拟/串口输出的当前值")
    addNote("v1.1.8: digital On/Off visible via OffColor, click snap-back")
    addNote("v1.1.8: 数字量开关颜色区分显示、误触自动回弹")
    addNote("        periodic update request keeps static digital in sync")
    addNote("        周期性更新请求保持静止数字量实时同步")

  elseif CurrentPage.ptype == "monitor" then
    local fs = 12
    -- Title
    table.insert(graphics, {
      Type = "Text",
      Text = "Monitor / 监控日志",
      FontSize = 14,
      HTextAlign = "Left",
      Position = {8, 4},
      Size = {300, 20}
    })

    -- System events area (connection / registration / errors)
    table.insert(graphics, {
      Type = "Text",
      Text = "System Events / 系统事件",
      FontSize = 10,
      HTextAlign = "Left",
      Position = {8, 28},
      Size = {324, 16}
    })
    layout["monitor_log"] = {
      PrettyName = "System Log",
      Style = "Text",
      FontSize = 8,
      HTextAlign = "Left",
      VTextAlign = "Top",
      Position = {8, 44},
      Size = {324, 130}
    }

    -- RX area: Crestron -> Q-SYS
    table.insert(graphics, {
      Type = "Text",
      Text = "RX  Crestron -> Q-SYS / 接收",
      FontSize = 10,
      HTextAlign = "Left",
      Position = {8, 178},
      Size = {324, 16}
    })
    layout["monitor_rx"] = {
      PrettyName = "RX Log",
      Style = "Text",
      FontSize = 8,
      HTextAlign = "Left",
      VTextAlign = "Top",
      Position = {8, 194},
      Size = {324, 130}
    }

    -- TX area: Q-SYS -> Crestron
    table.insert(graphics, {
      Type = "Text",
      Text = "TX  Q-SYS -> Crestron / 发送",
      FontSize = 10,
      HTextAlign = "Left",
      Position = {8, 328},
      Size = {324, 16}
    })
    layout["monitor_tx"] = {
      PrettyName = "TX Log",
      Style = "Text",
      FontSize = 8,
      HTextAlign = "Left",
      VTextAlign = "Top",
      Position = {8, 344},
      Size = {324, 130}
    }

    -- Clear button
    layout["monitor_clear"] = {
      PrettyName = "Clear Log",
      Legend = "Clear",
      Style = "Button",
      ButtonStyle = "Trigger",
      Color = Palette.Red,
      Margin = 2,
      Position = {8, 482},
      Size = {100, 30}
    }

    -- Status info
    table.insert(graphics, {
      Type = "Text",
      Text = "Max 30 lines each / 每区最多30行  |  Auto-scroll / 自动滚动",
      FontSize = 9,
      HTextAlign = "Left",
      Position = {120, 490},
      Size = {210, 20}
    })

    -- Notes
    table.insert(graphics, {
      Type = "GroupBox",
      Text = "Notes / 说明",
      FontSize = fs,
      HTextAlign = "Left",
      Fill = Palette.White,
      StrokeColor = Palette.Black,
      StrokeWidth = 1,
      CornerRadius = 6,
      Position = {8, 522},
      Size = {324, 150}
    })
    local mY = 538
    local function mNote(text)
      table.insert(graphics, {
        Type = "Text",
        Text = text,
        FontSize = 8,
        HTextAlign = "Left",
        Position = {14, mY},
        Size = {312, 13}
      })
      mY = mY + 13
    end
    mNote("Three independent log areas:")
    mNote("三个独立日志区：")
    mNote("System: connection / registration / error events")
    mNote("系统: 连接 / 注册 / 错误事件")
    mNote("RX: data received from Crestron (Crestron -> Q-SYS)")
    mNote("RX: 从Crestron收到的数据 (Crestron -> Q-SYS)")
    mNote("TX: data sent to Crestron (Q-SYS -> Crestron)")
    mNote("TX: 发往Crestron的数据 (Q-SYS -> Crestron)")

  elseif CurrentPage.ptype == "digital" then
    renderSignalPage(CurrentPage, "Digital")
  elseif CurrentPage.ptype == "analog" then
    renderSignalPage(CurrentPage, "Analog")
  elseif CurrentPage.ptype == "serial" then
    renderSignalPage(CurrentPage, "Serial")
  end

  return layout, graphics
end

--==============================================================================
-- Runtime logic (executes on Core)
-- v1.1.8: OffColor digital display, In-button snap-back, periodic update request
-- v1.1.7: full output sync (Digital/Analog/Serial) after re-registration
-- v1.1.6: monitor log split into System / RX (Crestron->QSC) / TX (QSC->Crestron)
-- v1.1.5: registration retry on IPID rejection (FF FF 02)
--         auto-reconnect when IP/IPID changed at runtime
-- v1.1.4: initial-sync flag, Level2 watchdog only before first signal data
--         rx buffer overflow guard, IP_Input panel-only, notes overflow fix
-- v1.1.3: fix forceReconnect forward ref, monitor fs nil, double connect on startup
--         boolean/integer property types, Led status indicator, RectifyProperties
-- v1.1.2: os.time() watchdog, post-reg signal check, forceReconnect()
-- v1.1.1: Watchdog timeout (30s no data -> force reconnect)
-- v1.1.0: Auto-reconnect, 0x03/0x0F/0x0D handling, multi-subpacket parse,
--          digital pulse stretching, analog value display
--==============================================================================
if Controls then

  local MAX_DIGITAL = math.floor(Properties["digital_count"].Value)
  local MAX_ANALOG  = math.floor(Properties["analog_count"].Value)
  local MAX_SERIAL  = math.floor(Properties["serial_count"].Value)
  local CIP_PORT    = 41794

  local tcp             = nil
  local pollTimer       = Timer.New()
  local hbTimer         = Timer.New()
  local reconnectTimer  = Timer.New()
  local regTimeoutTimer = Timer.New()
  local regRetryTimer   = Timer.New()
  local configChangeTimer = Timer.New()
  local watchdogTimer   = Timer.New()
  local syncTimer       = Timer.New()  -- periodic update request (static signal refresh)
  local isConnected     = false
  local isRegistered    = false
  local programReady    = false
  local rxBuffer        = ""
  local userDisconnected = false
  local lastConfigIP    = ""  -- last applied IP (for change detection)
  local lastConfigIPID  = ""  -- last applied IPID hex string (for change detection)
  local lastDataTime    = 0  -- os.time() of last received byte (incl. heartbeats)
  local lastSignalTime  = 0  -- os.time() of last real signal data (digital/analog/serial)
  local regCompleteTime = 0  -- os.time() when CIP registration succeeded
  local initialSyncDone = false  -- true after 0x1C end-of-query or first signal data
  local WATCHDOG_TIMEOUT = 20  -- seconds without ANY data before force-reconnect
  local POST_REG_TIMEOUT = 15  -- seconds after registration with no signal data -> force-reconnect

  -- Digital pulse timers (one per output join)
  local digitalPulseTimers = {}

  -- Last-known real values of digital inputs (from Crestron), used to
  -- restore panel display if user accidentally toggles the In button
  local digitalInState = {}

  -- Periodic-sync quiet flag: while true, per-signal RX/TX logs are suppressed
  -- so a periodic re-dump of all joins does not flood the monitor buffers.
  local syncQuiet = false
  local syncQuietTime = 0

  -- Monitor logs: three independent buffers (System / RX / TX)
  local sysLogLines = {}
  local rxLogLines  = {}
  local txLogLines  = {}
  local MAX_LOG_LINES = 30
  local function addLog(category, direction, detail)
    -- During a periodic re-sync, suppress per-signal noise; keep System events
    if syncQuiet and direction ~= "Event" then return end
    local ts = os.date("%H:%M:%S")
    local flow = ""
    if direction == "Out" then
      flow = "[QSC->Crestron]"
    elseif direction == "In" then
      flow = "[Crestron->QSC]"
    else
      flow = "[System]"
    end
    local line
    if direction == "Event" then
      line = ts .. "  " .. flow .. " [" .. category .. "] " .. detail
    else
      -- detail format: "N = value" -> split into join and value
      local eq = detail:find(" = ")
      if eq then
        local join = detail:sub(1, eq - 1)
        local value = detail:sub(eq + 3)
        line = ts .. "  " .. flow .. " [" .. category .. " " .. direction .. " " .. join .. "] = " .. value
      else
        line = ts .. "  " .. flow .. " [" .. category .. " " .. direction .. "] " .. detail
      end
    end
    -- Route to per-direction buffer + control
    local buf, ctrlName
    if direction == "In" then
      buf, ctrlName = rxLogLines, "monitor_rx"
    elseif direction == "Out" then
      buf, ctrlName = txLogLines, "monitor_tx"
    else
      buf, ctrlName = sysLogLines, "monitor_log"
    end
    table.insert(buf, line)
    while #buf > MAX_LOG_LINES do
      table.remove(buf, 1)
    end
    if Controls[ctrlName] then
      Controls[ctrlName].String = table.concat(buf, "\n")
    end
  end

  -- Config helpers
  local function getPulseWidth()
    return tonumber(Properties["digital_pulse_width"].Value) or 0.3
  end

  local function getReconnectInterval()
    return tonumber(Properties["reconnect_interval"].Value) or 5
  end

  local function isAutoReconnect()
    return Properties["auto_reconnect"].Value == true
  end

  local function getTargetIP()
    if Controls.IP_Input ~= nil and Controls.IP_Input.String ~= "" then
      return Controls.IP_Input.String
    end
    return Properties["cip_ip"].Value
  end

  local function getTargetIPID()
    local val
    if Controls.IPID_Input ~= nil and Controls.IPID_Input.String ~= "" then
      val = tonumber(Controls.IPID_Input.String, 16)
    end
    if not val then
      val = tonumber(Properties["cip_ipid"].Value, 16) or 3
    end
    -- Clamp to valid IPID range 0x03-0xFF
    return math.min(math.max(val, 0x03), 0xFF)
  end

  local function toHex(str)
    local hex = ""
    for i = 1, #str do
      hex = hex .. string.format("%02X ", str:byte(i))
    end
    return hex
  end

  local function updateAnalogVal(prefix, join, value)
    local ctrl = Controls[prefix .. "_" .. join .. "_Val"]
    if ctrl then ctrl.String = tostring(value) end
  end

  local function initControls()
    if Controls.CIP_Status then Controls.CIP_Status.Boolean = false end
    -- Do NOT reset CIP_Connect here - preserve user's choice during runtime
    isRegistered = false
    programReady = false
  end

  -- === CIP send functions ===
  function sendRegistration()
    if not tcp or not isConnected then return end
    local ipid = getTargetIPID()
    local pkt = string.char(0x01,0x00,0x0B,0x00,0x00,0x00,0x00,0x00,ipid,0x40,0xFF,0xFF,0xF1,0x01)
    tcp:Write(pkt)
    print("[CIP] Sent IPID registration (IPID=0x" .. string.format("%02X", ipid) .. ")")
  end

  function sendHeartbeat()
    if isConnected and tcp then
      tcp:Write(string.char(0x0D,0x00,0x02,0x00,0x00))
    end
  end

  -- Send update request: asks Crestron to re-dump ALL join values
  -- (digital/analog/serial). Crestron only sends signals on change, so a
  -- periodic re-request keeps static digital inputs/outputs in sync.
  function sendUpdateRequest(reason)
    if not tcp or not isConnected then return end
    tcp:Write(string.char(0x05,0x00,0x05,0x00,0x00,0x02,0x03,0x00))
    print("[CIP] Update request sent (" .. reason .. ")")
  end

  function sendDigital(join, value, silent)
    if not isRegistered or not tcp or join < 1 or join > MAX_DIGITAL then return end
    join = join - 1
    local jh = math.floor(join / 256)
    local jl = join % 256
    local flag = value and 0x00 or 0x80
    tcp:Write(string.char(0x05,0x00,0x06,0x00,0x00,0x03,0x00,jl,jh+flag))
    if not silent then addLog("Digital", "Out", (join + 1) .. " = " .. tostring(value)) end
  end

  function sendAnalog(join, value, silent)
    if not isRegistered or not tcp or join < 1 or join > MAX_ANALOG then return end
    join = join - 1
    value = math.min(math.max(tonumber(value) or 0, 0), 65535)
    local jh = math.floor(join / 256)
    local jl = join % 256
    local vh = math.floor(value / 256)
    local vl = value % 256
    tcp:Write(string.char(0x05,0x00,0x08,0x00,0x00,0x05,0x14,jh,jl,vh,vl))
    updateAnalogVal("Analog_Out", join + 1, value)
    if not silent then addLog("Analog", "Out", (join + 1) .. " = " .. value) end
  end

  function sendString(join, str, silent)
    if not isRegistered or not tcp or join < 1 or join > MAX_SERIAL then return end
    join = join - 1
    local s = tostring(str)
    local len = #s
    local payloadLen = 8 + len
    local lenH = math.floor(payloadLen / 256)
    local lenL = payloadLen % 256
    local jh = math.floor(join / 256)
    local jl = join % 256
    local pkt = string.char(0x12,lenH,lenL,0,0,0,4+len,0x34,jh,jl,0x03) .. s
    tcp:Write(pkt)
    if not silent then addLog("Serial", "Out", (join + 1) .. " = \"" .. s .. "\"") end
  end

  -- === Full output sync: re-send ALL output values after (re)registration ===
  -- After a reconnect the Crestron side has no knowledge of current output
  -- states, so we must push Digital/Analog/Serial outputs again.
  -- silent=true suppresses per-signal log spam (used by periodic sync).
  function syncOutputs(silent)
    if not isRegistered or not tcp then return end
    if not silent then
      print("[CIP] Syncing all outputs to Crestron...")
      addLog("CIP", "Event", "Syncing all outputs to Crestron")
    end
    -- Digital outputs (toggle current state)
    for i = 1, MAX_DIGITAL do
      local c = Controls["Digital_Out_" .. i]
      if c then sendDigital(i, c.Boolean, silent) end
    end
    -- Analog outputs (current knob value)
    for i = 1, MAX_ANALOG do
      local c = Controls["Analog_Out_" .. i]
      if c then sendAnalog(i, c.Value, silent) end
    end
    -- Serial outputs (current string)
    for i = 1, MAX_SERIAL do
      local c = Controls["Serial_Out_" .. i]
      if c then sendString(i, c.String, silent) end
    end
  end

  -- === Parse a single Cresnet subpacket ===
  local function parseSubPacket(subType, subData)
    -- Digital (0x00)
    if subType == 0x00 and #subData >= 2 then
      local jl = subData:byte(1)
      local jh = subData:byte(2)
      local join = ((jh & 0x7F) * 256 + jl) + 1
      if join >= 1 and join <= MAX_DIGITAL then
        local value = (jh & 0x80) == 0
        local ctrl = Controls["Digital_In_" .. join]
        if ctrl then
          ctrl.Boolean = value
          digitalInState[join] = value  -- remember true Crestron state
        end
        lastSignalTime = os.time()
        initialSyncDone = true
        addLog("Digital", "In", join .. " = " .. tostring(value))
      end
      return
    end
    -- Analog (0x14)
    if subType == 0x14 and #subData >= 4 then
      local jh = subData:byte(1)
      local jl = subData:byte(2)
      local vh = subData:byte(3)
      local vl = subData:byte(4)
      local join = jh * 256 + jl + 1
      if join >= 1 and join <= MAX_ANALOG then
        local value = vh * 256 + vl
        local ctrl = Controls["Analog_In_" .. join]
        if ctrl then ctrl.Value = value end
        updateAnalogVal("Analog_In", join, value)
        lastSignalTime = os.time()
        initialSyncDone = true
        addLog("Analog", "In", join .. " = " .. value)
      end
      return
    end
    -- Command (0x03)
    if subType == 0x03 and #subData >= 1 then
      local cmd = subData:byte(1)
      if cmd == 0x1C then
        -- End of initial dump, send ack
        initialSyncDone = true
        if tcp and isConnected then
          tcp:Write(string.char(0x05,0x00,0x05,0x00,0x00,0x02,0x03,0x1D))
        end
        -- Periodic re-sync finished -> resume logging
        if syncQuiet then
          syncQuiet = false
          addLog("CIP", "Event", "Periodic sync complete")
        end
        print("[CIP] Sync complete (end-of-query), ack sent")
      end
      return
    end
  end

  -- === Parse 0x05 data frame (may contain MULTIPLE subpackets) ===
  local function parseDataFrame(payload)
    local pos = 3  -- skip 2-byte handle, point to first subpacket len byte
    while pos <= #payload do
      local subLen = payload:byte(pos)
      if not subLen or subLen < 2 then break end
      if pos + 1 + subLen > #payload + 1 then break end
      local subType = payload:byte(pos + 1)
      local subData = payload:sub(pos + 2, pos + subLen)
      parseSubPacket(subType, subData)
      pos = pos + 1 + subLen
    end
  end

  -- === Parse 0x12 extended data frame ===
  local function parseExtendedFrame(payload)
    local pos = 3  -- skip 2-byte handle
    while pos + 2 <= #payload do
      local subLenH = payload:byte(pos)
      local subLenL = payload:byte(pos + 1)
      local subLen = subLenH * 256 + subLenL
      if subLen < 2 or pos + 1 + subLen > #payload then break end
      local subType = payload:byte(pos + 2)
      local subData = payload:sub(pos + 3, pos + 1 + subLen)
      -- Serial extended (0x34)
      if subType == 0x34 and #subData >= 3 then
        local jh = subData:byte(1)
        local jl = subData:byte(2)
        local join = jh * 256 + jl + 1
        if join >= 1 and join <= MAX_SERIAL then
          local str = subData:sub(4):gsub("[%z%c]", "")
          local ctrl = Controls["Serial_In_" .. join]
          if ctrl then ctrl.String = str end
          lastSignalTime = os.time()
          initialSyncDone = true
          addLog("Serial", "In", join .. " = \"" .. str .. "\"")
        end
      end
      pos = pos + 2 + subLen
    end
  end

  -- === Parse full CIP packet ===
  -- Forward declaration: forceReconnect is defined later but called from parsePacket
  local forceReconnect
  local function parsePacket(pkt)
    if #pkt < 4 then return end
    local typ = pkt:byte(1)
    local lenH = pkt:byte(2)
    local lenL = pkt:byte(3)
    local payloadLen = lenH * 256 + lenL
    local payload = pkt:sub(4)

    -- 0x02: Registration response
    if typ == 0x02 and payloadLen >= 3 then
      if payload:sub(1,3) == "\xFF\xFF\x02" then
        print("[CIP] IPID not defined or processor booting (FF FF 02)")
        addLog("CIP", "Event", "IPID rejected (FF FF 02), retrying in 5s")
        -- Auto-retry registration: processor may still be booting
        regRetryTimer:Stop()
        regRetryTimer:Start(5)
      else
        isRegistered = true
        regCompleteTime = os.time()
        regTimeoutTimer:Stop()
        regRetryTimer:Stop()
        print("[CIP] IPID registration successful (result: " .. toHex(payload) .. ")")
        addLog("CIP", "Event", "Registered IPID=0x" .. string.format("%02X", getTargetIPID()))
        -- Send update request to get initial join values
        sendUpdateRequest("initial registration")
        -- Re-send all output states to Crestron (output sync after reconnect)
        syncOutputs()
        -- Start periodic re-sync so static digital signals keep refreshing
        local syncInt = tonumber(Properties["sync_interval"].Value) or 60
        syncTimer:Stop()
        if syncInt > 0 then
          syncTimer:Start(syncInt)
        end
        hbTimer:Start(15)
      end
      return
    end

    -- 0x03: Disconnect from processor (program stop/reload)
    -- This is NOT a user disconnect — must auto-reconnect
    if typ == 0x03 then
      print("[CIP] Received disconnect (0x03) from processor - program stopped/reloaded")
      addLog("CIP", "Event", "Processor disconnect (0x03)")
      forceReconnect("processor sent 0x03 disconnect")
      return
    end

    -- 0x0F: Program status (0=loading, 1=not running, 2=ready)
    if typ == 0x0F and payloadLen >= 1 then
      local status = payload:byte(1)
      if status == 2 then
        programReady = true
        print("[CIP] Program ready (0x0F=2), sending registration")
        sendRegistration()
        regTimeoutTimer:Start(5)  -- 5s timeout for registration response
      else
        programReady = false
        print("[CIP] Program status=" .. status .. " (0=loading, 1=not running, 2=ready), waiting...")
      end
      return
    end

    -- 0x05: Data frame (may have multiple subpackets)
    if typ == 0x05 then
      parseDataFrame(payload)
      return
    end

    -- 0x12: Extended data (serial)
    if typ == 0x12 then
      parseExtendedFrame(payload)
      return
    end

    -- 0x0D: Heartbeat request FROM processor - MUST reply 0x0E
    if typ == 0x0D then
      if tcp and isConnected then
        tcp:Write(string.char(0x0E,0x00,0x02,0x00,0x00))
      end
      return
    end

    -- 0x0E: Heartbeat response from processor
    if typ == 0x0E then
      -- Crestron is alive; lastDataTime already updated in pollTimer
      return
    end

    -- Unhandled
    if typ ~= 0x0D and typ ~= 0x0E then
      print("[CIP] Unhandled pkt type=0x" .. string.format("%02X", typ) ..
            " len=" .. payloadLen .. " hex=" .. toHex(pkt))
    end
  end

  -- === Connect / Disconnect ===
  function doConnect()
    userDisconnected = false
    reconnectTimer:Stop()
    regTimeoutTimer:Stop()
    regRetryTimer:Stop()
    configChangeTimer:Stop()
    syncTimer:Stop()
    syncQuiet = false
    if tcp ~= nil then
      tcp:Disconnect()
      tcp = nil
    end
    isConnected = false
    isRegistered = false
    programReady = false
    rxBuffer = ""
    initialSyncDone = false
    lastConfigIP = getTargetIP()
    lastConfigIPID = string.format("%02X", getTargetIPID())
    tcp = TcpSocket.New()
    tcp.EventHandler = function(s, eventType)
      if eventType == "CONNECTED" then
        isConnected = true
        lastDataTime = os.time()
        lastSignalTime = 0
        regCompleteTime = 0
        initialSyncDone = false
        if Controls.CIP_Status then Controls.CIP_Status.Boolean = true end
        if Controls.CIP_Connect then Controls.CIP_Connect.Boolean = true end
        print("[TCP] Connected to " .. getTargetIP() .. ":" .. CIP_PORT)
        addLog("TCP", "Event", "Connected " .. getTargetIP() .. ":" .. CIP_PORT)
        pollTimer:Start(0.05)
        watchdogTimer:Start(5)
        -- Wait for 0x0F program-ready before registering (per CIP spec)
        -- Fallback: if no 0x0F within 3s, register anyway
        regTimeoutTimer:Start(3)
      elseif eventType == "CLOSED" then
        isConnected = false
        isRegistered = false
        programReady = false
        initControls()
        hbTimer:Stop()
        pollTimer:Stop()
        regTimeoutTimer:Stop()
        regRetryTimer:Stop()
        configChangeTimer:Stop()
        syncTimer:Stop()
        syncQuiet = false
        watchdogTimer:Stop()
        print("[TCP] Connection closed")
        addLog("TCP", "Event", "Connection closed")
        if not userDisconnected and isAutoReconnect() then
          print("[CIP] Auto-reconnect in " .. getReconnectInterval() .. "s")
          addLog("TCP", "Event", "Auto-reconnect in " .. getReconnectInterval() .. "s")
          reconnectTimer:Start(getReconnectInterval())
        end
      elseif eventType == "ERROR" then
        isConnected = false
        isRegistered = false
        programReady = false
        initControls()
        hbTimer:Stop()
        pollTimer:Stop()
        regTimeoutTimer:Stop()
        regRetryTimer:Stop()
        configChangeTimer:Stop()
        syncTimer:Stop()
        syncQuiet = false
        watchdogTimer:Stop()
        print("[TCP] Connection error - check IP/network/Crestron")
        addLog("TCP", "Event", "Connection error")
        if not userDisconnected and isAutoReconnect() then
          print("[CIP] Auto-reconnect in " .. getReconnectInterval() .. "s")
          addLog("TCP", "Event", "Auto-reconnect in " .. getReconnectInterval() .. "s")
          reconnectTimer:Start(getReconnectInterval())
        end
      end
    end
    tcp:Connect(getTargetIP(), CIP_PORT)
  end

  function doDisconnect()
    userDisconnected = true
    reconnectTimer:Stop()
    regTimeoutTimer:Stop()
    regRetryTimer:Stop()
    configChangeTimer:Stop()
    syncTimer:Stop()
    syncQuiet = false
    hbTimer:Stop()
    pollTimer:Stop()
    watchdogTimer:Stop()
    if tcp then
      tcp:Disconnect()
      tcp = nil
    end
    isConnected = false
    isRegistered = false
    programReady = false
    initControls()
    print("[TCP] Disconnected by user")
  end

  -- Registration timeout: if no 0x0F in 3s, register anyway
  regTimeoutTimer.EventHandler = function()
    if isConnected and not isRegistered then
      print("[CIP] No 0x0F program status received, registering anyway (fallback)")
      sendRegistration()
      regTimeoutTimer:Start(5)  -- another 5s for registration response
    end
  end

  -- Registration retry: auto-re-register after IPID rejection (FF FF 02)
  regRetryTimer.EventHandler = function()
    if isConnected and not isRegistered then
      print("[CIP] Retrying IPID registration...")
      addLog("CIP", "Event", "Retrying registration")
      sendRegistration()
      regRetryTimer:Start(5)
    end
  end

  -- Config change debounce: IP/IPID edited -> reconnect with new settings
  configChangeTimer.EventHandler = function()
    if isConnected and not userDisconnected then
      print("[CIP] IP/IPID changed, reconnecting...")
      addLog("TCP", "Event", "IP/IPID changed, reconnecting")
      doConnect()
    end
  end

  -- Reconnect timer
  reconnectTimer.EventHandler = function()
    if not userDisconnected and isAutoReconnect() then
      print("[CIP] Auto-reconnecting...")
      doConnect()
    end
  end

  -- Force reconnect: cleanly tear down and schedule reconnect (NOT user-initiated)
  forceReconnect = function(reason)
    print("[CIP] Force reconnect: " .. reason)
    addLog("TCP", "Event", "Force reconnect: " .. reason)
    if tcp then
      tcp:Disconnect()
      tcp = nil
    end
    isConnected = false
    isRegistered = false
    programReady = false
    regCompleteTime = 0
    initialSyncDone = false
    initControls()
    hbTimer:Stop()
    pollTimer:Stop()
    regTimeoutTimer:Stop()
    regRetryTimer:Stop()
    configChangeTimer:Stop()
    syncTimer:Stop()
    syncQuiet = false
    watchdogTimer:Stop()
    if isAutoReconnect() then
      reconnectTimer:Start(getReconnectInterval())
    end
  end

  -- Watchdog: catches dead connections and fake CIP sessions
  -- Level 1: no TCP data at all for WATCHDOG_TIMEOUT -> Crestron gone
  -- Level 2: registered but no signal data AND initial sync not complete -> fake session
  --   (after initial sync / first signal, idle systems are normal — only Level 1 applies)
  watchdogTimer.EventHandler = function()
    if not isConnected or userDisconnected then return end
    local now = os.time()
    -- Level 1: no data at all
    local noData = now - lastDataTime
    if noData > WATCHDOG_TIMEOUT then
      forceReconnect("no data for " .. noData .. "s (Crestron unreachable)")
      return
    end
    -- Level 2: registered but no real signal data AND initial sync not yet confirmed
    if isRegistered and regCompleteTime > 0 and not initialSyncDone then
      local refTime = lastSignalTime > regCompleteTime and lastSignalTime or regCompleteTime
      local noSignal = now - refTime
      if noSignal > POST_REG_TIMEOUT then
        forceReconnect("registered but no signal data for " .. noSignal .. "s (fake CIP session)")
        return
      end
    end
    -- Safety: if periodic-sync quiet mode is stuck (no 0x1C reply), un-silence
    if syncQuiet and now - syncQuietTime > 25 then
      syncQuiet = false
      addLog("CIP", "Event", "Periodic sync timeout, logging resumed")
    end
  end

  -- Heartbeat
  hbTimer.EventHandler = sendHeartbeat

  -- Periodic re-sync: re-request full dump so static digital signals
  -- (which Crestron only sends on change) keep refreshing, then re-send
  -- all output states to Crestron.
  syncTimer.EventHandler = function()
    if not isConnected or not isRegistered then return end
    syncQuiet = true  -- suppress per-signal logs until dump completes
    syncQuietTime = os.time()
    sendUpdateRequest("periodic sync")
    syncOutputs(true)
    local syncInt = tonumber(Properties["sync_interval"].Value) or 60
    if syncInt > 0 then syncTimer:Start(syncInt) end
  end

  -- Data polling
  pollTimer.EventHandler = function()
    if not isConnected or not tcp then return end
    local data = tcp:Read(4096)
    if data then
      rxBuffer = rxBuffer .. data
      lastDataTime = os.time()
      -- Guard: prevent unbounded buffer growth on malformed data
      if #rxBuffer > 65536 then
        print("[CIP] RX buffer overflow (" .. #rxBuffer .. " bytes), clearing")
        rxBuffer = ""
      end
    end
    while #rxBuffer >= 4 do
      local lenH = rxBuffer:byte(2)
      local lenL = rxBuffer:byte(3)
      local totalLen = 3 + (lenH * 256 + lenL)
      if totalLen < 4 or #rxBuffer < totalLen then break end
      parsePacket(rxBuffer:sub(1, totalLen))
      rxBuffer = rxBuffer:sub(totalLen + 1)
    end
  end

  -- Connect button
  Controls.CIP_Connect.EventHandler = function(c)
    if c.Boolean then
      doConnect()
    else
      doDisconnect()
    end
  end

  -- IP / IPID change detection: auto-reconnect when edited at runtime
  -- Debounced 1s so typing does not trigger multiple reconnects
  if Controls.IP_Input then
    Controls.IP_Input.EventHandler = function(c)
      local newIP = c.String
      if newIP ~= "" and newIP ~= lastConfigIP then
        configChangeTimer:Stop()
        configChangeTimer:Start(1)
      end
    end
  end
  if Controls.IPID_Input then
    Controls.IPID_Input.EventHandler = function(c)
      local v = tonumber(c.String, 16)
      if v and v >= 0x03 and v <= 0xFF then
        local newID = string.format("%02X", v)
        if newID ~= lastConfigIPID then
          configChangeTimer:Stop()
          configChangeTimer:Start(1)
        end
      end
    end
  end

  -- Monitor clear button
  if Controls.monitor_clear then
    Controls.monitor_clear.EventHandler = function(c)
      sysLogLines = {}
      rxLogLines = {}
      txLogLines = {}
      if Controls.monitor_log then Controls.monitor_log.String = "System cleared." end
      if Controls.monitor_rx  then Controls.monitor_rx.String  = "RX cleared." end
      if Controls.monitor_tx  then Controls.monitor_tx.String  = "TX cleared." end
    end
  end

  -- === Digital inputs: read-only display ===
  -- Digital_In pins come FROM Crestron; the panel button must only display
  -- the true state. If the user clicks it, immediately snap back to the
  -- last known Crestron value (prevents display desync).
  for i = 1, MAX_DIGITAL do
    local ctrl = Controls["Digital_In_" .. i]
    if ctrl then
      ctrl.EventHandler = function(c)
        c.Boolean = digitalInState[i] or false
      end
    end
  end

  -- === Digital outputs with PULSE STRETCHING ===
  -- Short trigger pulses (10ms) are stretched to pulse_width (default 0.3s)
  -- Long toggle holds are preserved: release only when user actually releases
  for i = 1, MAX_DIGITAL do
    local ctrl = Controls["Digital_Out_" .. i]
    if ctrl then
      digitalPulseTimers[i] = Timer.New()
      digitalPulseTimers[i].EventHandler = function()
        -- Timer fired after pulse_width: if button already released (short
        -- trigger), send release now. If still held (toggle mode), wait for
        -- the actual falling edge.
        if not ctrl.Boolean then
          sendDigital(i, false)
        end
      end
      ctrl.EventHandler = function(c)
        if c.Boolean then
          -- Rising edge: send press immediately + start stretch timer
          sendDigital(i, true)
          digitalPulseTimers[i]:Start(getPulseWidth())
        else
          -- Falling edge: if timer already expired (long hold), release now.
          -- If timer still running (short trigger), it will release at pulse_width.
          if not digitalPulseTimers[i]:IsRunning() then
            sendDigital(i, false)
          end
        end
      end
    end
  end

  -- Analog outputs
  for i = 1, MAX_ANALOG do
    local ctrl = Controls["Analog_Out_" .. i]
    if ctrl then
      ctrl.EventHandler = function(c)
        sendAnalog(i, c.Value)
      end
    end
  end

  -- Serial outputs
  for i = 1, MAX_SERIAL do
    local ctrl = Controls["Serial_Out_" .. i]
    if ctrl then
      ctrl.EventHandler = function(c)
        sendString(i, c.String)
      end
    end
  end

  -- === Startup ===
  initControls()
  lastConfigIP = getTargetIP()
  lastConfigIPID = string.format("%02X", getTargetIPID())

  -- Verify monitor controls exist and initialize (System / RX / TX)
  if Controls.monitor_log then
    Controls.monitor_log.String = "System ready."
    print("[Monitor] monitor_log control OK (external output pin enabled)")
  else
    print("[Monitor] WARNING: monitor_log control NOT found!")
  end
  if Controls.monitor_rx then
    Controls.monitor_rx.String = "RX ready."
    print("[Monitor] monitor_rx control OK (external output pin enabled)")
  else
    print("[Monitor] WARNING: monitor_rx control NOT found!")
  end
  if Controls.monitor_tx then
    Controls.monitor_tx.String = "TX ready."
    print("[Monitor] monitor_tx control OK (external output pin enabled)")
  else
    print("[Monitor] WARNING: monitor_tx control NOT found!")
  end

  print("==================================")
  print("crestronCIP gateway v1.1.8 started")
  print("Digital: " .. MAX_DIGITAL .. " | Analog: " .. MAX_ANALOG .. " | Serial: " .. MAX_SERIAL)
  print("Pulse: " .. getPulseWidth() .. "s | Auto-reconnect: " .. tostring(isAutoReconnect()) ..
        " (" .. getReconnectInterval() .. "s)")
  print("IPID: 0x" .. string.format("%02X", getTargetIPID()))
  print("==================================")

  -- Default: auto-connect on startup. Set Connect toggle ON for visual feedback,
  -- then call doConnect() explicitly. Programmatic Boolean changes during init
  -- may not fire EventHandler reliably, so explicit call is required.
  if Controls.CIP_Connect then
    Controls.CIP_Connect.Boolean = true
  end
  print("[CIP] Auto-connecting on startup (default connected mode)")
  doConnect()

end
